# ─────────────────────────────────────────────────────────────────────────────
# EUDR Compliance Assistant — environment variables
#
# Copy this file to `.env` and fill in the values. All variables are validated
# at runtime by `src/lib/env-validation.ts`; the app will refuse to start with
# missing or malformed values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma + pg driver adapter).
DATABASE_URL="postgresql://user:password@localhost:5432/eudr?schema=public"

# Auth secrets — each must be at least 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
REFRESH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Resend — transactional email (supplier invitations, welcome emails).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Cloudflare R2 (S3-compatible object storage for generated export bundles).
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="eudr-exports"
R2_PUBLIC_URL="https://files.example.com"

# Public base URL of the deployed app (used in invitation links). Must be a URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
